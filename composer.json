{
    "name": "kiyodori/sgtech-upgrade-handson",
    "description": "SGTech 勉強会 #1 ハンズオン用の備品貸出管理アプリ",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "cakephp/cakephp": "^4.5",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
